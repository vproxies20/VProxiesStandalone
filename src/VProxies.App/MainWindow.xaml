<Window x:Class="VProxies.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VProxies SA" Width="1280" Height="780" MinWidth="1080" MinHeight="680" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="assets/vproxies-logo.png" Width="34" Height="34"/><TextBlock Text="VProxies SA" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/><TextBlock Text="1.5.0" Foreground="{DynamicResource MutedBrush}" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,6">
          <Button x:Name="ProxyNavButton" Style="{StaticResource SidebarNavButton}" Width="107" Height="76" Click="ProxyNav_Click" ToolTip="Proxy Management"><StackPanel><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="Proxy Management" FontFamily="Segoe UI" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Button>
          <Button x:Name="SettingsNavButton" Style="{StaticResource SidebarNavButton}" Width="107" Height="76" Click="SettingsNav_Click" ToolTip="Settings"><StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="Settings" FontFamily="Segoe UI" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Button>
          <Button x:Name="LogNavButton" Style="{StaticResource SidebarNavButton}" Width="107" Height="76" Click="LogNav_Click" ToolTip="Activity Log"><StackPanel><TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="Activity Log" FontFamily="Segoe UI" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitleText" Text="VProxies SA" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="PageSubtitleText" Text="Local multi-proxy routing" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,12,0"><Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#9099A6"/><TextBlock x:Name="StatusText" Text="ROUTING STOPPED" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" FontSize="12"/><TextBlock x:Name="ConnectionDetailText" Text="" Visibility="Collapsed"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ApplyRoutingButton" Content="▶  START ROUTING" Style="{StaticResource PrimaryButton}" Click="ApplyRouting_Click" Padding="18,10"/><Button x:Name="StopRoutingButton" Content="■  STOP" Style="{StaticResource GhostButton}" Click="StopRouting_Click" IsEnabled="False" Padding="16,10"/></StackPanel><Border x:Name="StatusBadge" Visibility="Collapsed"/>
      </Grid></Border>
      <Grid Grid.Row="1" Margin="18">
        <Grid x:Name="ProxyPage"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="190"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width=".9*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="170"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="14,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="PROXY SERVERS" FontSize="15" FontWeight="Bold"/><TextBlock Text="Use several proxies at the same time" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel><Button Grid.Column="1" Content="＋ NEW PROXY" Style="{StaticResource SmallButton}" Click="NewProxy_Click"/></Grid>
              <DataGrid Grid.Row="1" x:Name="ProxyGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ProxyGrid_SelectionChanged" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" RowBackground="{DynamicResource InputBrush}" AlternatingRowBackground="{DynamicResource AltPanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource LineBrush}" CanUserAddRows="False" SelectionUnit="FullRow" RowHeight="46"><DataGrid.Columns><DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.05*"/><DataGridTextColumn Header="TYPE" Binding="{Binding ProtocolText}" Width=".7*"/><DataGridTextColumn Header="ENDPOINT" Binding="{Binding EndpointText}" Width="1.25*"/></DataGrid.Columns></DataGrid>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="14,10,14,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Proxy name" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBox x:Name="ProxyNameBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Protocol" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><ComboBox x:Name="ProtocolBox" SelectedIndex="3"><ComboBoxItem Content="HTTP"/><ComboBoxItem Content="HTTPS"/><ComboBoxItem Content="SOCKS4"/><ComboBoxItem Content="SOCKS5"/></ComboBox></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Host or IP" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBox x:Name="HostBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Port" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBox x:Name="PortBox" Text="1080"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Username / SOCKS4 User ID" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBox x:Name="ProxyUsernameBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Password" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><PasswordBox x:Name="ProxyPasswordBox"/></StackPanel></Grid><TextBlock Text="HTTPS SNI (optional)" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBox x:Name="SniBox"/><TextBlock Text="Passwords are protected by Windows DPAPI." Foreground="{DynamicResource MutedBrush}" FontSize="9"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="DeleteProxyButton" Content="DELETE" Style="{StaticResource DangerButton}" Click="DeleteProxy_Click" IsEnabled="False"/><Button x:Name="TestProxyButton" Content="CHECK" Style="{StaticResource GhostButton}" Click="TestProxy_Click"/><Button x:Name="SaveProxyButton" Content="ADD PROXY" Style="{StaticResource PrimaryButton}" Click="SaveProxy_Click"/></WrapPanel></StackPanel></ScrollViewer>
            </Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="230"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="14,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="APPLICATION ROUTING" FontSize="15" FontWeight="Bold"/><TextBlock Text="Choose Proxy, Direct, or Block for each application" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></StackPanel><Button Grid.Column="1" Content="＋ NEW RULE" Style="{StaticResource SmallButton}" Click="NewRule_Click"/></Grid>
              <DataGrid Grid.Row="1" x:Name="RuleGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="RuleGrid_SelectionChanged" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" RowBackground="{DynamicResource InputBrush}" AlternatingRowBackground="{DynamicResource AltPanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource LineBrush}" CanUserAddRows="False" SelectionUnit="FullRow" RowHeight="50"><DataGrid.Columns><DataGridTemplateColumn Header="APPLICATION" Width="1.35*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold"/><TextBlock Text="{Binding LocationText}" Foreground="{DynamicResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="ROUTE THROUGH" Binding="{Binding TargetText}" Width="1.05*"/></DataGrid.Columns></DataGrid>
              <StackPanel Grid.Row="2" Margin="14,10,14,14"><TextBlock Text="Application (.exe)" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ApplicationPathBox"/><Button Grid.Column="1" Content="BROWSE" Style="{StaticResource GhostButton}" Click="BrowseApplication_Click" Margin="7,5,0,8"/></Grid><TextBlock Text="Route through" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><ComboBox x:Name="RuleTargetBox" DisplayMemberPath="Name" SelectedValuePath="Id"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="DeleteRuleButton" Content="DELETE" Style="{StaticResource DangerButton}" Click="DeleteRule_Click" IsEnabled="False"/><Button x:Name="SaveRuleButton" Content="ADD RULE" Style="{StaticResource PrimaryButton}" Click="SaveRule_Click"/></WrapPanel></StackPanel>
            </Grid></Border>
          </Grid>
          <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="QUICK ACTIVITY" FontWeight="Bold" FontSize="12"/><RichTextBox Grid.Row="1" x:Name="LogBox" Margin="0,8,0,0" Background="{DynamicResource InputBrush}" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10.5" Padding="8"><FlowDocument PagePadding="0"/></RichTextBox></Grid></Border>
        </Grid>
        <Grid x:Name="SettingsPage" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width=".9*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width=".9*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top"><StackPanel><TextBlock Text="GENERAL &amp; APP BEHAVIOR" FontSize="17" FontWeight="Bold"/><TextBlock Text="GENERAL" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,18,0,5"/><CheckBox x:Name="CloseToTrayBox" Content="Close button minimizes to tray" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/><TextBlock Text="Closing completely always asks for confirmation." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,18"/><Separator Background="{DynamicResource LineBrush}"/><TextBlock Text="INTERFACE THEME" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,18,0,5"/><ComboBox x:Name="ThemeBox" SelectionChanged="Theme_Changed"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox><TextBlock Text="System follows the Windows app theme." Foreground="{DynamicResource MutedBrush}" FontSize="10"/><Separator Background="{DynamicResource LineBrush}" Margin="0,18,0,12"/><TextBlock Text="CONFIGURATION" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/><WrapPanel><Button Content="EXPORT CONFIG" Style="{StaticResource GhostButton}" Click="ExportConfig_Click"/><Button Content="IMPORT CONFIG" Style="{StaticResource GhostButton}" Click="ImportConfig_Click"/></WrapPanel><TextBlock Text="Passwords remain encrypted for this Windows user." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
          <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top"><StackPanel><TextBlock Text="NETWORK &amp; SAFETY" FontSize="17" FontWeight="Bold"/><TextBlock Text="DEFAULT &amp; SAFETY" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,18,0,5"/><TextBlock Text="Apps without a rule" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><ComboBox x:Name="DefaultTargetBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Settings_Changed"/><CheckBox x:Name="StrictRouteBox" Content="Kill Switch (Strict Routing)" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/><CheckBox x:Name="RemoteDnsBox" Content="DNS Leak Protection" IsChecked="False" Checked="Settings_Changed" Unchecked="Settings_Changed" ToolTip="Routes DNS through the selected proxy"/><TextBlock Text="DNS Server" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,10,0,0"/><TextBox x:Name="DnsServerBox" Text="1.1.1.1" LostFocus="Settings_Changed" ToolTip="IPv4 or IPv6 DNS server. Saved automatically."/><TextBlock Text="The DNS checkbox and server are saved automatically." Foreground="#66CDAA" FontSize="10"/><TextBlock Text="Direct uses this computer's normal IP. Block denies the connection." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border>
          <Border Grid.Column="4" Style="{StaticResource CardStyle}" VerticalAlignment="Top"><StackPanel><TextBlock Text="LICENSE" FontSize="17" FontWeight="Bold"/><TextBlock Text="ACTIVATION STATUS" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,18,0,5"/><TextBlock x:Name="LicenseStatusText" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"/><TextBlock Text="DEVICE ID" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,18,0,5"/><TextBlock x:Name="LicenseDeviceText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/><Button Content="CHANGE LICENSE" Style="{StaticResource GhostButton}" Click="ChangeLicense_Click" Margin="0,20,0,0"/><TextBlock Text="The license is verified locally and locked to this computer." Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
        </Grid>
        <Grid x:Name="ActivityLogPage" Visibility="Collapsed"><Border Style="{StaticResource CardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions><Grid Margin="15,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="ACTIVITY LOG" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/><Button Grid.Column="1" Content="CLEAR" Style="{StaticResource SmallButton}" Click="ClearLog_Click"/></Grid><RichTextBox Grid.Row="1" x:Name="LogPageBox" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Padding="14"><FlowDocument PagePadding="0"/></RichTextBox><TextBlock Grid.Row="2" Text="Logs are kept in memory for this session · up to 400 entries" Foreground="{DynamicResource MutedBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12"/></Grid></Border></Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
