<Window x:Class="VProxies.ActivationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Activate VProxies SA" Width="660" Height="570" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" ShowInTaskbar="True">
  <Grid Margin="34">
    <Border Style="{StaticResource CardStyle}" Padding="30">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Image Source="assets/vproxies-logo.png" Width="48" Height="48"/><StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="VProxies SA" FontWeight="Bold" FontSize="25"/><TextBlock Text="LICENSE ACTIVATION" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11"/></StackPanel></StackPanel>
        <TextBlock Grid.Row="1" Text="A license is required to use this application. Send the device ID below to the seller, then paste the license key you receive." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,24,0,18" LineHeight="20"/>
        <StackPanel Grid.Row="2"><TextBlock Text="THIS COMPUTER'S DEVICE ID" Foreground="{DynamicResource MutedBrush}" FontWeight="Bold" FontSize="11"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DeviceIdBox" IsReadOnly="True" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"/><Button Grid.Column="1" Content="COPY" Style="{StaticResource GhostButton}" Click="CopyDeviceId_Click" Margin="8,5,0,8"/></Grid></StackPanel>
        <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="LICENSE KEY" Foreground="{DynamicResource MutedBrush}" FontWeight="Bold" FontSize="11"/><TextBox x:Name="LicenseKeyBox" Height="94" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></StackPanel>
        <TextBlock Grid.Row="4" x:Name="StatusText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Grid Grid.Row="5" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="License stored securely for this Windows user." Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/><Button Grid.Column="1" Content="EXIT" Style="{StaticResource GhostButton}" Click="Exit_Click"/><Button Grid.Column="2" Content="ACTIVATE" Style="{StaticResource PrimaryButton}" Click="Activate_Click" Padding="24,10"/></Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
