<Window x:Class="VProxies.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VProxies SA" Width="1460" Height="900" MinWidth="1180" MinHeight="720" Background="{StaticResource PageBrush}" Foreground="#F8FAFC" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#091322" BorderBrush="#1F314A" BorderThickness="0,0,0,1" Padding="22,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="assets/vproxies-logo.png" Width="52" Height="52"/>
          <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"><TextBlock Text="VProxies SA" Foreground="{StaticResource AccentBrush}" FontSize="24" FontWeight="Bold"/><Border Background="#41243B" CornerRadius="8" Padding="8,3" Margin="9,3,0,2"><TextBlock Text="1.2.1" Foreground="#FF9BB5" FontSize="11" FontWeight="Bold"/></Border></StackPanel>
            <TextBlock Text="Local multi-proxy routing · No account or API required" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" x:Name="StatusBadge" Background="#2B3449" CornerRadius="19" Padding="15,8" Margin="8,0">
          <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#FF718B" Margin="0,0,8,0"/><StackPanel><TextBlock x:Name="StatusText" Text="Routing stopped" Foreground="#FF9BA8" FontWeight="Bold"/><TextBlock x:Name="ConnectionDetailText" Text="Apps use this PC connection" Foreground="#8295AE" FontSize="10"/></StackPanel></StackPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ApplyRoutingButton" Content="▶  APPLY ROUTING" Style="{StaticResource PrimaryButton}" Click="ApplyRouting_Click" Padding="18,11"/>
          <Button x:Name="StopRoutingButton" Content="■  STOP" Style="{StaticResource DangerButton}" Click="StopRouting_Click" IsEnabled="False" Padding="18,11"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="14"/><ColumnDefinition Width=".84*"/></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="230"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="18,17,18,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PROXY SERVERS" FontSize="20" FontWeight="Bold"/><TextBlock Text="All proxies can route different apps at the same time." Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel><Button Grid.Column="1" Content="＋ NEW" Style="{StaticResource GhostButton}" Click="NewProxy_Click"/></Grid>
          <DataGrid Grid.Row="1" x:Name="ProxyGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ProxyGrid_SelectionChanged" Background="#0B1627" Foreground="#EAF3FF" RowBackground="#0D192A" AlternatingRowBackground="#101E31" BorderBrush="#243650" BorderThickness="0,1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1B2B42" HeadersVisibility="Column" CanUserAddRows="False" SelectionUnit="FullRow" RowHeight="45">
            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#17364C"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
            <DataGrid.Columns><DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.1*"/><DataGridTextColumn Header="TYPE" Binding="{Binding ProtocolText}" Width=".7*"/><DataGridTextColumn Header="ENDPOINT" Binding="{Binding EndpointText}" Width="1.25*"/></DataGrid.Columns>
          </DataGrid>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,13,18,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Proxy name" Foreground="#B8C8DC" FontSize="11"/><TextBox x:Name="ProxyNameBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Protocol" Foreground="#B8C8DC" FontSize="11"/><ComboBox x:Name="ProtocolBox" SelectedIndex="3"><ComboBoxItem Content="HTTP"/><ComboBoxItem Content="HTTPS"/><ComboBoxItem Content="SOCKS4"/><ComboBoxItem Content="SOCKS5"/></ComboBox></StackPanel></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Host or IP" Foreground="#B8C8DC" FontSize="11"/><TextBox x:Name="HostBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Port" Foreground="#B8C8DC" FontSize="11"/><TextBox x:Name="PortBox" Text="1080"/></StackPanel></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Username / SOCKS4 User ID" Foreground="#B8C8DC" FontSize="11"/><TextBox x:Name="ProxyUsernameBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Password" Foreground="#B8C8DC" FontSize="11"/><PasswordBox x:Name="ProxyPasswordBox"/></StackPanel></Grid>
            <TextBlock Text="HTTPS SNI (optional)" Foreground="#B8C8DC" FontSize="11"/><TextBox x:Name="SniBox"/>
            <TextBlock Text="Passwords are encrypted with Windows DPAPI for this Windows user." Foreground="#687D98" FontSize="10" TextWrapping="Wrap"/>
            <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0"><Button x:Name="DeleteProxyButton" Content="DELETE" Style="{StaticResource DangerButton}" Click="DeleteProxy_Click" IsEnabled="False"/><Button x:Name="TestProxyButton" Content="CHECK" Style="{StaticResource GhostButton}" Click="TestProxy_Click"/><Button x:Name="SaveProxyButton" Content="ADD PROXY" Style="{StaticResource PrimaryButton}" Click="SaveProxy_Click"/></WrapPanel>
          </StackPanel></ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="300"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="18,17,18,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="APPLICATION ROUTING" FontSize="20" FontWeight="Bold"/><TextBlock Text="Choose a proxy, Direct, or Block for each app." Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel><Button Grid.Column="1" Content="＋ NEW" Style="{StaticResource GhostButton}" Click="NewRule_Click"/></Grid>
          <DataGrid Grid.Row="1" x:Name="RuleGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="RuleGrid_SelectionChanged" Background="#0B1627" Foreground="#EAF3FF" RowBackground="#0D192A" AlternatingRowBackground="#101E31" BorderBrush="#243650" BorderThickness="0,1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1B2B42" HeadersVisibility="Column" CanUserAddRows="False" SelectionUnit="FullRow" RowHeight="52">
            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#17364C"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
            <DataGrid.Columns><DataGridTemplateColumn Header="APPLICATION" Width="1.35*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold"/><TextBlock Text="{Binding LocationText}" Foreground="#7186A3" FontSize="9" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="ROUTE THROUGH" Binding="{Binding TargetText}" Width="1.05*"/></DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Margin="18,15,18,18">
            <TextBlock Text="Application (.exe)" Foreground="#B8C8DC" FontSize="11"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ApplicationPathBox"/><Button Grid.Column="1" Content="BROWSE" Style="{StaticResource GhostButton}" Click="BrowseApplication_Click" Margin="8,5,0,8"/></Grid>
            <TextBlock Text="Route through" Foreground="#B8C8DC" FontSize="11"/><ComboBox x:Name="RuleTargetBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            <Border Background="#0A1729" BorderBrush="#203753" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,7,0,7"><StackPanel><TextBlock Text="HOW IT WORKS" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Example: Chrome → Proxy 1, Telegram → Proxy 2, Game → Direct. These routes work simultaneously while VProxies SA is active." Foreground="#A9BAD0" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
            <WrapPanel HorizontalAlignment="Right"><Button x:Name="DeleteRuleButton" Content="DELETE" Style="{StaticResource DangerButton}" Click="DeleteRule_Click" IsEnabled="False"/><Button x:Name="SaveRuleButton" Content="ADD RULE" Style="{StaticResource PrimaryButton}" Click="SaveRule_Click"/></WrapPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="DEFAULT &amp; SAFETY" FontSize="17" FontWeight="Bold"/><TextBlock Text="Apps without a rule" Foreground="#B8C8DC" FontSize="11" Margin="0,13,0,0"/><ComboBox x:Name="DefaultTargetBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Settings_Changed"/><CheckBox x:Name="StrictRouteBox" Content="Strict routing protection" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/><CheckBox x:Name="RemoteDnsBox" Content="DNS leak protection (through proxy)" IsChecked="False" Checked="Settings_Changed" Unchecked="Settings_Changed" ToolTip="Routes DNS through the default proxy, or the first proxy when Default is Direct"/><TextBlock Text="DNS server" Foreground="#B8C8DC" FontSize="11" Margin="0,7,0,0"/><TextBox x:Name="DnsServerBox" Text="1.1.1.1" LostFocus="Settings_Changed" ToolTip="IPv4 or IPv6 DNS server. The value is saved automatically."/><TextBlock Text="DNS choices are saved automatically." Foreground="#7186A3" FontSize="10" Margin="0,-3,0,4"/><CheckBox x:Name="CloseToTrayBox" Content="Close button minimizes to tray" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/><TextBlock Text="Direct means the app uses this computer's normal public IP. Block prevents the app from connecting." Foreground="#7186A3" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="ACTIVITY LOG" FontWeight="Bold" FontSize="12"/><Button Grid.Column="1" Content="CLEAR" Style="{StaticResource SmallButton}" Click="ClearLog_Click"/></Grid><RichTextBox Grid.Row="1" x:Name="LogBox" Margin="0,8,0,0" Background="#081321" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10.5" Padding="8"><FlowDocument PagePadding="0"/></RichTextBox></Grid></Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
