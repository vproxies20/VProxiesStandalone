<Window x:Class="VProxiesSA.Keygen.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VProxies SA License Generator" Width="720" Height="720" MinWidth="640" MinHeight="650" WindowStartupLocation="CenterScreen" Background="{StaticResource Page}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
  <Grid Margin="28"><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="28"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="VProxies SA" FontSize="26" FontWeight="Bold"/><TextBlock Text="PRIVATE LICENSE GENERATOR" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Keep this tool and its private key secret. Never upload them to GitHub or send them to customers." Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,12,0,18"/></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="CUSTOMER / NOTE (OPTIONAL)" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><TextBox x:Name="CustomerBox" MaxLength="100"/></StackPanel>
    <StackPanel Grid.Row="2"><TextBlock Text="CUSTOMER DEVICE ID" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><TextBox x:Name="DeviceIdBox" FontFamily="Consolas" MaxLength="80"/></StackPanel>
    <StackPanel Grid.Row="3"><CheckBox x:Name="LifetimeBox" Content="Lifetime license" IsChecked="True" Checked="Lifetime_Changed" Unchecked="Lifetime_Changed"/><TextBlock Text="EXPIRATION DATE" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Margin="0,8,0,0"/><DatePicker x:Name="ExpirationPicker" SelectedDateFormat="Short"/></StackPanel>
    <Grid Grid.Row="4" Margin="0,8,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Foreground="#F87171" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="GENERATE LICENSE" Click="Generate_Click" Background="#0FCFE1" Foreground="#04131A" BorderBrush="#67E8F9" Padding="22,10"/></Grid>
    <StackPanel Grid.Row="5"><TextBlock Text="LICENSE KEY" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><TextBox x:Name="LicenseKeyBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="150" FontFamily="Consolas"/></StackPanel>
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="COPY KEY" Click="CopyKey_Click"/><Button Content="SAVE KEY..." Click="SaveKey_Click"/></StackPanel>
  </Grid></Border></Grid>
</Window>
